<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obereg"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic нужен для демонстрационной проверки трафика по http://.
          Боевой клиент должен ходить только по https (проверка выполняется через локальный SOCKS5-прокси ядра).
        -->

        <activity
            android:name=".FeedActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".LibraryActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:label="@string/player_title" />

        <activity
            android:name=".EnginePlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|layoutDirection"
            android:supportsPictureInPicture="true"
            android:label="@string/player_title" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name" />

        <activity
            android:name=".CatalogActivity"
            android:exported="false"
            android:label="@string/action_open_catalog" />

        <activity
            android:name=".YouTubeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/action_open_youtube"
            android:hardwareAccelerated="true" />

        <receiver
            android:name=".PipControls"
            android:exported="false" />

        <service
            android:name=".TunnelService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
