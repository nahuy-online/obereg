<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0F1115">

    <!-- Шапка: логотип слева, поиск / уведомления / отчёт / профиль справа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оберег"
            android:textColor="#EEF1F6"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnHeadSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon"
            android:contentDescription="Поиск"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnHeadBell"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon"
            android:contentDescription="Уведомления"
            android:src="@drawable/ic_bell" />

        <ImageButton
            android:id="@+id/btnHeadReport"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon"
            android:contentDescription="Скопировать отчёт"
            android:src="@drawable/ic_report" />

        <ImageButton
            android:id="@+id/btnHeadProfile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon"
            android:contentDescription="Профиль"
            android:src="@drawable/ic_person" />
    </LinearLayout>

    <TextView
        android:id="@+id/feedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="оберег: запуск"
        android:textColor="#8B93A5"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <Button
            android:id="@+id/btnLibLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon"
            android:backgroundTint="#161A21"
            android:text="Войти в аккаунт"
            android:textColor="#7AA2FF"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLibPlaylists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon"
            android:backgroundTint="#161A21"
            android:text="Плейлисты"
            android:textColor="#CFD8E6"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/feedList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#00000000"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/shortsStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:text="Shorts скоро: вертикальные ленты появятся в следующей сборке"
            android:textColor="#8B93A5"
            android:textSize="14sp"
            android:visibility="gone" />

        <WebView
            android:id="@+id/feedWebView"
            android:layout_width="1dp"
            android:layout_height="1dp" />
    </FrameLayout>

    <!-- Мини-плеер: ролик продолжает играть внизу приложения, как в GreenTuber -->
    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161A21"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/miniPlayerHolder"
            android:layout_width="106dp"
            android:layout_height="60dp"
            android:background="#000000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#EEF1F6"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/miniPlayerSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="играет в мини-плеере"
                android:textColor="#8B93A5"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMiniPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="⏯"
            android:textColor="#EEF1F6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnMiniClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="✕"
            android:textColor="#8B93A5"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Нижняя навигация: Главная / Shorts / Подписки / Библиотека -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#13161D">

        <Button
            android:id="@+id/navMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#00000000"
            android:drawableTop="@drawable/ic_nav_home"
            android:paddingTop="8dp"
            android:paddingBottom="11dp"
            android:text="Главная"
            android:textColor="#7AA2FF"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/navShorts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#00000000"
            android:drawableTop="@drawable/ic_nav_shorts"
            android:paddingTop="8dp"
            android:paddingBottom="11dp"
            android:text="Shorts"
            android:textColor="#8B93A5"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/navSubs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#00000000"
            android:drawableTop="@drawable/ic_nav_subs"
            android:paddingTop="8dp"
            android:paddingBottom="11dp"
            android:text="Подписки"
            android:textColor="#8B93A5"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/navLib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#00000000"
            android:drawableTop="@drawable/ic_nav_lib"
            android:paddingTop="8dp"
            android:paddingBottom="11dp"
            android:text="Библиотека"
            android:textColor="#8B93A5"
            android:textSize="10.5sp" />
    </LinearLayout>
    </LinearLayout>

    <!-- Экран плеера прямо в оболочке: одно окно приложения — без переездов окон -->
    <include
        layout="@layout/activity_engine_player"
        android:id="@+id/playerPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Лёгкие чипы под видео: скорость и «В окне» (перенесены из верхней полосы) -->
    <LinearLayout
        android:id="@+id/floatBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="240dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnFloatSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="1×"
            android:textColor="#EEF1F6"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnFloatPip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="▢ В окне"
            android:textColor="#7AA2FF"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
