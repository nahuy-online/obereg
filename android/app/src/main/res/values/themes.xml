        <item name="android:statusBarColor">@android:color/black</item>
        <item name="colorPrimary">#5B8CFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#161A21</item>
        <item name="colorOnPrimaryContainer">#EEF1F6</item>
        <item name="colorSecondaryContainer">#161A21</item>
        <item name="colorOnSecondaryContainer">#7AA2FF</item>
        <item name="colorSurface">#0F1115</item>
        <item name="colorOnSurface">#EEF1F6</item>
